AZURE_LOCATION=polandcentral
RESOURCE_GROUP=kedify-vcluster-kpa-demo
RESOURCE_PREFIX=kfyvcdemo
DEPLOYMENT_NAME=kedify-vcluster-kpa

MAIN_NODE_COUNT=3
MAIN_NODE_VM_SIZE=Standard_D8s_v5
MAIN_KUBERNETES_VERSION=1.35.8
REDIS_NODE_COUNT=2
REDIS_NODE_VM_SIZE=Standard_D4s_v5

# Released chart containing Agent, KEDA, and KPA.
AGENT_CHART=kedify/kedify-agent
AGENT_CHART_VERSION=v0.8.1

# Kedify credentials. Copy this file to .env and replace these placeholders.
KEDIFY_ORG_ID=00000000-0000-4000-8000-000000000000
KEDIFY_API_KEY=kfy_replace_me
KEDIFY_CLUSTER_NAME=keda-vcluster
# KEDIFY_AGENT_ID=00000000-0000-4000-8000-000000000000
